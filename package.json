{
    "name": "@mfe-orchestrator-hub/client-react",
    "version": "0.2.0",
    "description": "React bindings for @mfe-orchestrator-hub/client: provider and hooks over the MFE Orchestrator client",
    "license": "MIT",
    "author": "Lorenzo De Francesco",
    "type": "module",
    "packageManager": "pnpm@10.19.0",
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "mfe",
        "microfrontend",
        "module-federation",
        "orchestrator",
        "react"
    ],
    "homepage": "https://github.com/mfe-orchestrator/client-react#readme",
    "bugs": {
        "url": "https://github.com/mfe-orchestrator/client-react/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mfe-orchestrator/client-react.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint --write ./src ./test",
        "format": "biome format --write ./src ./test",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@mfe-orchestrator-hub/client": "^0.2.0"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.4",
        "jsdom": "^30.0.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.8",
        "tsup": "^8.5.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    }
}
